{
  "name": "prv",
  "version": "0.0.0",
  "private": true,
  "description": "Pull-Request like View — local GitHub-style diff viewer for AI-agent changes and arbitrary directory comparisons.",
  "bin": {
    "prv": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile --target=bun src/cli.ts --outfile dist/prv",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
